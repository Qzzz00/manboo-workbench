{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__WORKBENCH_HOOKS__/agent-hook.sh codex",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__WORKBENCH_HOOKS__/agent-hook.sh codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__WORKBENCH_HOOKS__/agent-hook.sh codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
