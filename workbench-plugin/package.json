{
  "name": "@ben/dsh-workbench",
  "version": "0.4.192",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "workbench": "lib/workbench.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
